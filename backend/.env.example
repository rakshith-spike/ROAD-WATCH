APP_NAME=RoadWatch Intelligence API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# FIX: both localhost and 127.0.0.1 — browsers treat these as different origins
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=roadwatch

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=14

GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Smart Intelligence mock dataset controls
INTELLIGENCE_SEED=20260521
INTELLIGENCE_DEFAULT_LIMIT=120
